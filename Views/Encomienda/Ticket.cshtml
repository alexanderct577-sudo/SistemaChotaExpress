@model SistemaChotaExpress.Models.Encomienda
@{
    Layout = null;
    string rucEmisor = "20600308883";
    string razonSocialEmisor = "EMPRESA DE MULTISERVICIOS Y TRANSPORTES TURS CHOTA EXPRESS S.A.C.";
    string nombreComercial = "TOURS CHOTA EXPRESS";
    string direccionEmisor = "CAL. SARA MACDOUGALL NRO. 218 BAR. SAN JOSE - CHOTA - CAJAMARCA";

    var agencias = new[] {
        new { Ciudad = "CHOTA (Principal)", Dir = "Jr. José Arana 290 / Cal. Sara Macdougall 218", Tel = "948 211 532" },
        new { Ciudad = "CHICLAYO", Dir = "Calle Agricultura 210", Tel = "941 931 014" },
        new { Ciudad = "CUTERVO", Dir = "Jr. 22 de Octubre 1713 / Jr. Comercio 1116", Tel = "954 956 993" },
        new { Ciudad = "CAJAMARCA", Dir = "Jr. Angamos 970", Tel = "951 314 266 / (076) 267458" },
        new { Ciudad = "BAMBAMARCA", Dir = "Av. Ricardo Palma 697", Tel = "948 211 532" }
    };

    string tipoComp = Model.TipoComprobante; // Boleta, Factura, Ticket
    string tituloDoc = tipoComp.Equals("Factura", StringComparison.OrdinalIgnoreCase) ? "FACTURA ELECTRÓNICA" :
                       tipoComp.Equals("Ticket", StringComparison.OrdinalIgnoreCase) ? "TICKET DE ENCOMIENDA" : "BOLETA DE VENTA ELECTRÓNICA";
    string numeroDoc = Model.NumeroComprobante;
    bool esFactura = tipoComp.Equals("Factura", StringComparison.OrdinalIgnoreCase);

    string formato = ViewBag.Formato as string ?? "termal";
    bool esNuevo = (bool)(ViewBag.EsNuevo ?? false);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@tituloDoc @numeroDoc - Tours Chota Express</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.6/dist/JsBarcode.all.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style id="dynamicPageStyle">
        @if (formato == "a4") {
            <text>@@page { size: A4 portrait; margin: 10mm; }</text>
        } else {
            <text>@@page { size: 80mm auto; margin: 0; }</text>
        }
    </style>

    <style>
        * { box-sizing: border-box; }

        body {
            font-family: 'Consolas', 'Courier New', monospace, sans-serif;
            background-color: #1a1d21;
            color: #111;
            margin: 0;
            padding: 15px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        /* Toolbar Superior */
        .actions-panel {
            width: 100%;
            max-width: 820px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #23272d;
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 12px 18px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.45);
            gap: 12px;
            flex-wrap: wrap;
        }

        .actions-title {
            color: #fff;
            font-size: 0.95rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .view-switch-btns {
            display: flex;
            background: #14171a;
            padding: 3px;
            border-radius: 8px;
            gap: 4px;
        }

        .btn-tab {
            background: transparent;
            color: #94a3b8;
            border: none;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .btn-tab:hover { color: #fff; }
        .btn-tab.active {
            background: #f37021;
            color: #fff;
            box-shadow: 0 2px 8px rgba(243, 112, 33, 0.4);
        }

        .action-btns {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .btn-act {
            padding: 8px 14px;
            border-radius: 8px;
            font-size: 0.82rem;
            font-weight: 700;
            cursor: pointer;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: transform 0.1s, opacity 0.2s;
        }
        .btn-act:hover { opacity: 0.9; transform: translateY(-1px); }
        .btn-act:active { transform: translateY(0); }
        .btn-print { background: #10b981; color: #fff; }
        .btn-pdf { background: #ef4444; color: #fff; }
        .btn-ws { background: #25d366; color: #fff; }
        .btn-back { background: #374151; color: #e5e7eb; }
        .btn-new { background: #f59e0b; color: #000; }

        /* Contenedor del Comprobante */
        .voucher-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        /* ===== ESTILO 1: TICKET TÉRMICO 80mm ===== */
        .thermal-ticket {
            width: 80mm;
            background: #ffffff;
            padding: 6mm 4mm;
            border-radius: 4px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            font-size: 11px;
            line-height: 1.35;
            color: #000;
            margin-bottom: 20px;
        }

        .t-center { text-align: center; }
        .t-right { text-align: right; }
        .t-bold { font-weight: 700; }
        .t-uppercase { text-transform: uppercase; }

        .t-header-logo {
            font-size: 17px;
            font-weight: 900;
            letter-spacing: 0.5px;
            margin-bottom: 2px;
        }
        .t-company-name { font-size: 9.5px; font-weight: 700; line-height: 1.2; }
        .t-company-sub { font-size: 8.5px; color: #333; margin-top: 1px; }

        .t-sunat-box {
            border: 1.5px solid #000;
            padding: 4px 6px;
            margin: 6px 0;
            text-align: center;
            border-radius: 3px;
        }
        .t-sunat-box .t-doc-title { font-size: 12px; font-weight: 900; margin: 2px 0; }
        .t-sunat-box .t-doc-num { font-size: 13px; font-weight: 900; letter-spacing: 0.5px; }

        .t-divider {
            border-top: 1px dashed #000;
            margin: 5px 0;
        }
        .t-divider-double {
            border-top: 2px solid #000;
            margin: 6px 0;
        }

        .t-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 2px;
            font-size: 10.5px;
        }
        .t-row-label { font-weight: 700; color: #000; }

        .t-clave-box {
            background: #f1f5f9;
            border: 1.5px dashed #000;
            padding: 6px;
            margin: 6px 0;
            text-align: center;
            border-radius: 4px;
        }
        .t-clave-val {
            font-size: 18px;
            font-weight: 900;
            letter-spacing: 2px;
            color: #000;
        }

        .t-route-banner {
            background: #000;
            color: #fff;
            padding: 4px;
            text-align: center;
            font-weight: 900;
            font-size: 13px;
            border-radius: 2px;
            margin: 4px 0;
        }

        .t-barcode-container {
            text-align: center;
            margin: 6px 0;
        }
        .t-barcode-container svg {
            max-width: 100%;
            height: 38px;
        }

        .t-qr-container {
            display: flex;
            justify-content: center;
            margin: 6px 0;
        }

        .t-footer {
            text-align: center;
            font-size: 8.5px;
            color: #333;
            margin-top: 6px;
            line-height: 1.25;
        }

        /* ===== ESTILO 2: FORMATO A4 / OFICIAL ===== */
        .a4-voucher {
            width: 210mm;
            min-height: 297mm;
            background: #ffffff;
            padding: 15mm 18mm;
            box-shadow: 0 10px 40px rgba(0,0,0,0.5);
            font-family: 'Segoe UI', Arial, sans-serif;
            font-size: 12px;
            color: #1e293b;
            line-height: 1.4;
            display: none;
            margin-bottom: 20px;
        }

        .a4-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #f37021;
            padding-bottom: 12px;
            margin-bottom: 15px;
        }
        .a4-company-info h1 {
            font-size: 22px;
            font-weight: 900;
            color: #f37021;
            margin: 0 0 2px 0;
        }
        .a4-company-info p {
            margin: 1px 0;
            font-size: 10.5px;
            color: #475569;
        }
        .a4-sunat-badge {
            border: 2px solid #0f172a;
            border-radius: 8px;
            padding: 10px 18px;
            text-align: center;
            min-width: 220px;
            background: #f8fafc;
        }
        .a4-sunat-badge .ruc { font-size: 13px; font-weight: 800; color: #0f172a; }
        .a4-sunat-badge .title { font-size: 14px; font-weight: 900; margin: 4px 0; color: #f37021; text-transform: uppercase; }
        .a4-sunat-badge .num { font-size: 15px; font-weight: 800; color: #0f172a; letter-spacing: 1px; }

        .a4-grid-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 15px;
        }
        .a4-card {
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 10px 12px;
            background: #ffffff;
        }
        .a4-card-title {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            color: #f37021;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 4px;
            margin-bottom: 6px;
        }
        .a4-card-row {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            margin-bottom: 3px;
        }

        .a4-route-box {
            background: #f8fafc;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 10px 14px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .a4-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 11.5px;
        }
        .a4-table th {
            background: #0f172a;
            color: #ffffff;
            padding: 8px 10px;
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
        }
        .a4-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #e2e8f0;
        }

        .a4-totals-section {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 15px;
        }
        .a4-security-box {
            border: 2px dashed #f59e0b;
            background: #fffbeb;
            padding: 10px 16px;
            border-radius: 8px;
            text-align: center;
            max-width: 320px;
        }
        .a4-totals-table {
            width: 260px;
            font-size: 12px;
        }
        .a4-totals-table tr td:last-child {
            text-align: right;
            font-weight: 700;
        }
        .a4-total-row {
            font-size: 14px;
            font-weight: 900;
            color: #0f172a;
            border-top: 2px solid #0f172a;
        }

        /* ===== MODO IMPRESIÓN ===== */
        @@media print {
            body {
                background: #ffffff !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            .no-print {
                display: none !important;
            }
            .thermal-ticket, .a4-voucher {
                box-shadow: none !important;
                margin: 0 !important;
            }
            @if (formato == "a4") {
                <text>
                .thermal-ticket { display: none !important; }
                .a4-voucher { display: block !important; }
                </text>
            } else {
                <text>
                .thermal-ticket { display: block !important; }
                .a4-voucher { display: none !important; }
                </text>
            }
        }
    </style>
</head>
<body onload="@(esNuevo ? "autoImprimir()" : "")">

    <!-- TOOLBAR SUPERIOR -->
    <div class="actions-panel no-print">
        <div class="actions-title">
            <i class="fa-solid fa-box text-warning"></i>
            <span>Comprobante de Encomienda: <strong style="color: #f37021;">@numeroDoc</strong> (@Model.CodigoSeguimiento)</span>
        </div>

        <div class="view-switch-btns">
            <button class="btn-tab @(formato == "termal" ? "active" : "")" onclick="cambiarVista('termal')">
                <i class="fa-solid fa-receipt"></i> Ticket Térmico (80mm)
            </button>
            <button class="btn-tab @(formato == "a4" ? "active" : "")" onclick="cambiarVista('a4')">
                <i class="fa-regular fa-file-lines"></i> Comprobante A4
            </button>
        </div>

        <div class="action-btns">
            <button class="btn-act btn-print" onclick="window.print()">
                <i class="fa-solid fa-print"></i> Imprimir
            </button>
            <button class="btn-act btn-ws" onclick="enviarWhatsApp()">
                <i class="fa-brands fa-whatsapp"></i> WhatsApp
            </button>
            <button class="btn-act btn-pdf" onclick="descargarPDF()">
                <i class="fa-solid fa-file-pdf"></i> PDF
            </button>
            <a asp-action="Registrar" class="btn-act btn-new" title="Registrar otra encomienda">
                <i class="fa-solid fa-plus"></i> Nueva Encomienda
            </a>
            <a asp-action="Index" class="btn-act btn-back">
                <i class="fa-solid fa-list"></i> Lista
            </a>
        </div>
    </div>

    <!-- WRAPPER COMPROBANTE -->
    <div class="voucher-wrapper">

        <!-- ========================================================= -->
        <!-- FORMATO 1: TICKET TÉRMICO DE 80MM (DEFAULT PARA IMPRESORA)-->
        <!-- ========================================================= -->
        <div class="thermal-ticket" id="thermalTicketArea" style="display: @(formato == "a4" ? "none" : "block");">
            <!-- ENCABEZADO -->
            <div class="t-center">
                <div class="t-header-logo">CHOTA EXPRESS</div>
                <div class="t-company-name">@razonSocialEmisor</div>
                <div class="t-company-sub">RUC: @rucEmisor | @direccionEmisor</div>
                <div class="t-company-sub">Central de Encomiendas: 948 211 532 / 941 931 014</div>
            </div>

            <!-- CUADRO SUNAT -->
            <div class="t-sunat-box">
                <div class="t-bold" style="font-size: 11px;">R.U.C. @rucEmisor</div>
                <div class="t-doc-title">@tituloDoc</div>
                <div class="t-doc-num">N° @numeroDoc</div>
            </div>

            <div class="t-row">
                <span class="t-row-label">CÓD. ENVÍO:</span>
                <span class="t-bold" style="font-size: 12px;">@Model.CodigoSeguimiento</span>
            </div>
            <div class="t-row">
                <span class="t-row-label">FECHA EMISIÓN:</span>
                <span>@Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
            </div>

            <!-- RUTA -->
            <div class="t-route-banner">
                @(Model.ObjetoRuta?.Origen ?? "CHOTA") ➔ @(Model.ObjetoRuta?.Destino ?? "DESTINO")
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.TurnoSalida) || !string.IsNullOrWhiteSpace(Model.NombreConductor))
            {
                <div class="t-row">
                    <span class="t-row-label">TURNO SALIDA:</span>
                    <span class="t-bold">@(Model.TurnoSalida ?? "Directo")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.NombreConductor))
                {
                    <div class="t-row">
                        <span class="t-row-label">CONDUCTOR:</span>
                        <span class="t-uppercase">@Model.NombreConductor</span>
                    </div>
                }
            }

            <div class="t-divider"></div>

            <!-- REMITENTE -->
            <div class="t-bold" style="font-size: 10px; color: #222;">DATOS DEL REMITENTE (ENVÍA):</div>
            <div class="t-bold t-uppercase" style="font-size: 11px;">@Model.NombreRemitente</div>
            @if (!string.IsNullOrWhiteSpace(Model.RucRemitente))
            {
                <div>RUC: <strong class="t-bold">@Model.RucRemitente</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DniRemitente))
            {
                <div>DNI: @Model.DniRemitente</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TelefonoRemitente))
            {
                <div>Telf: @Model.TelefonoRemitente</div>
            }

            <div class="t-divider"></div>

            <!-- DESTINATARIO -->
            <div class="t-bold" style="font-size: 10px; color: #222;">DATOS DEL DESTINATARIO (RECIBE):</div>
            <div class="t-bold t-uppercase" style="font-size: 11px;">@Model.NombreDestinatario</div>
            @if (!string.IsNullOrWhiteSpace(Model.DniDestinatario))
            {
                <div>DNI: <strong class="t-bold">@Model.DniDestinatario</strong></div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.RucDestinatario))
            {
                <div>RUC: @Model.RucDestinatario</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.TelefonoDestinatario))
            {
                <div>Telf: @Model.TelefonoDestinatario</div>
            }

            <div class="t-divider"></div>

            <!-- DETALLE DEL PAQUETE -->
            <div class="t-bold" style="font-size: 10px; color: #222;">DETALLE DE LA CARGA / ENCOMIENDA:</div>
            <div style="font-size: 11px; margin: 2px 0;">@Model.Descripcion</div>
            <div class="t-row">
                <span class="t-row-label">PESO REGISTRADO:</span>
                <span>@(Model.PesoKg.HasValue ? $"{Model.PesoKg:N1} kg" : "1.0 kg")</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ObservacionesLimpias))
            {
                <div class="t-row">
                    <span class="t-row-label">OBS:</span>
                    <span>@Model.ObservacionesLimpias</span>
                </div>
            }

            <div class="t-divider"></div>

            <!-- TOTALES -->
            @if (esFactura)
            {
                <div class="t-row">
                    <span>OP. GRAVADA:</span>
                    <span>S/ @Model.Subtotal.ToString("N2")</span>
                </div>
                <div class="t-row">
                    <span>I.G.V. (18%):</span>
                    <span>S/ @Model.Igv.ToString("N2")</span>
                </div>
            }
            <div class="t-row" style="font-size: 14px; font-weight: 900; margin-top: 3px;">
                <span>TOTAL A PAGAR:</span>
                <span>S/ @Model.PrecioEnvio.ToString("N2")</span>
            </div>
            <div class="t-row" style="font-size: 10px;">
                <span>FORMA DE PAGO:</span>
                <span class="t-bold t-uppercase">@Model.MetodoPago</span>
            </div>

            <!-- CLAVE DE RECOJO / SEGURIDAD -->
            @if (!string.IsNullOrWhiteSpace(Model.ClaveEnvio))
            {
                <div class="t-clave-box">
                    <div class="t-bold" style="font-size: 9.5px; text-transform: uppercase;">🔒 CLAVE SECRETA DE RECOJO:</div>
                    <div class="t-clave-val">@Model.ClaveEnvio</div>
                    <div style="font-size: 8px; color: #475569;">Indispensable brindar esta clave y DNI en ventanilla de destino</div>
                </div>
            }

            <!-- CÓDIGO DE BARRAS -->
            <div class="t-barcode-container">
                <svg id="barcodeThermal"></svg>
            </div>

            <!-- CÓDIGO QR -->
            <div class="t-qr-container">
                <div id="qrcodeThermal"></div>
            </div>

            <!-- FOOTER LEGAL -->
            <div class="t-footer">
                <div>Atendido por: <strong>@(Model.UsuarioRegistro?.Name ?? "Ventanilla Chota Express")</strong></div>
                <div class="t-bold" style="margin-top: 3px;">¡Gracias por su preferencia!</div>
                <div style="margin-top: 2px;">Rastree su paquete en www.chotaexpress.com con el código <strong>@Model.CodigoSeguimiento</strong></div>
                <div style="font-size: 7.5px; margin-top: 4px; color: #555;">
                    Conserve este comprobante. Es requisito para el retiro del envío.
                    Representación impresa de @(tituloDoc).
                </div>
            </div>
            <div style="margin-top: 15px; text-align: center; color: #fff;">.</div>
        </div>

        <!-- ========================================================= -->
        <!-- FORMATO 2: COMPROBANTE OFICIAL A4 / HOJA COMPLETA        -->
        <!-- ========================================================= -->
        <div class="a4-voucher" id="a4VoucherArea" style="display: @(formato == "a4" ? "block" : "none");">
            <!-- HEADER A4 -->
            <div class="a4-header">
                <div class="a4-company-info">
                    <h1>TOURS CHOTA EXPRESS</h1>
                    <p style="font-weight: 700; font-size: 12px; color: #0f172a;">@razonSocialEmisor</p>
                    <p><i class="fa-solid fa-location-dot text-warning"></i> @direccionEmisor</p>
                    <p><i class="fa-solid fa-phone text-warning"></i> Central Telefónica: 948 211 532 / 941 931 014</p>
                    <p><i class="fa-solid fa-envelope text-warning"></i> encomiendas@chotaexpress.com | www.chotaexpress.com</p>
                </div>
                <div class="a4-sunat-badge">
                    <div class="ruc">R.U.C. @rucEmisor</div>
                    <div class="title">@tituloDoc</div>
                    <div class="num">N° @numeroDoc</div>
                    <div style="font-size: 10px; color: #64748b; margin-top: 4px;">Código de Envío: @Model.CodigoSeguimiento</div>
                </div>
            </div>

            <!-- GRID INFO REMITENTE & DESTINATARIO -->
            <div class="a4-grid-info">
                <!-- Remitente -->
                <div class="a4-card">
                    <div class="a4-card-title"><i class="fa-solid fa-user me-1"></i> Remitente (Quien Envía)</div>
                    <div class="a4-card-row">
                        <span class="text-muted">Nombre / Razón Social:</span>
                        <strong class="t-uppercase">@Model.NombreRemitente</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.RucRemitente))
                    {
                        <div class="a4-card-row">
                            <span class="text-muted">R.U.C.:</span>
                            <strong>@Model.RucRemitente</strong>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DniRemitente))
                    {
                        <div class="a4-card-row">
                            <span class="text-muted">D.N.I.:</span>
                            <strong>@Model.DniRemitente</strong>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TelefonoRemitente))
                    {
                        <div class="a4-card-row">
                            <span class="text-muted">Teléfono / Celular:</span>
                            <span>@Model.TelefonoRemitente</span>
                        </div>
                    }
                </div>

                <!-- Destinatario -->
                <div class="a4-card">
                    <div class="a4-card-title"><i class="fa-solid fa-user-check me-1"></i> Destinatario (Quien Recibe)</div>
                    <div class="a4-card-row">
                        <span class="text-muted">Nombre Completo:</span>
                        <strong class="t-uppercase">@Model.NombreDestinatario</strong>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.DniDestinatario))
                    {
                        <div class="a4-card-row">
                            <span class="text-muted">D.N.I.:</span>
                            <strong>@Model.DniDestinatario</strong>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.RucDestinatario))
                    {
                        <div class="a4-card-row">
                            <span class="text-muted">R.U.C.:</span>
                            <strong>@Model.RucDestinatario</strong>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.TelefonoDestinatario))
                    {
                        <div class="a4-card-row">
                            <span class="text-muted">Teléfono / Celular:</span>
                            <span>@Model.TelefonoDestinatario</span>
                        </div>
                    }
                </div>
            </div>

            <!-- TRAYECTO Y TRASLADO -->
            <div class="a4-route-box">
                <div>
                    <span style="font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase;">Trayecto de Carga:</span>
                    <div style="font-size: 16px; font-weight: 900; color: #0f172a;">
                        <i class="fa-solid fa-van-shuttle text-warning me-1"></i>
                        @(Model.ObjetoRuta?.Origen ?? "CHOTA") <span style="color: #f37021;">➔</span> @(Model.ObjetoRuta?.Destino ?? "DESTINO")
                    </div>
                </div>
                <div>
                    <span style="font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase;">Fecha y Hora:</span>
                    <div style="font-size: 13px; font-weight: 700; color: #0f172a;">
                        @Model.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.TurnoSalida))
                {
                    <div>
                        <span style="font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase;">Turno de Salida:</span>
                        <div style="font-size: 13px; font-weight: 700; color: #0f172a;">@Model.TurnoSalida</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.NombreConductor))
                {
                    <div>
                        <span style="font-size: 11px; color: #64748b; font-weight: 700; text-transform: uppercase;">Conductor Asignado:</span>
                        <div style="font-size: 13px; font-weight: 700; color: #0f172a;">@Model.NombreConductor</div>
                    </div>
                }
            </div>

            <!-- TABLA DE DETALLE -->
            <table class="a4-table">
                <thead>
                    <tr>
                        <th style="width: 60px; text-align: center;">Item</th>
                        <th style="width: 80px; text-align: center;">Código</th>
                        <th>Descripción del Servicio / Encomienda</th>
                        <th style="width: 90px; text-align: center;">Peso (Kg)</th>
                        <th style="width: 100px; text-align: right;">Precio (S/)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td style="text-align: center; font-weight: 700;">1</td>
                        <td style="text-align: center; font-family: monospace; font-weight: 700;">@Model.CodigoSeguimiento</td>
                        <td>
                            <strong>SERVICIO DE TRANSPORTE DE ENCOMIENDAS</strong><br />
                            <span style="color: #475569;">Contenido: @Model.Descripcion</span>
                            @if (!string.IsNullOrWhiteSpace(Model.ObservacionesLimpias))
                            {
                                <br /><small style="color: #64748b;"><em>Obs: @Model.ObservacionesLimpias</em></small>
                            }
                        </td>
                        <td style="text-align: center;">@(Model.PesoKg.HasValue ? $"{Model.PesoKg:N1} kg" : "1.0 kg")</td>
                        <td style="text-align: right; font-weight: 700;">@Model.PrecioEnvio.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>

            <!-- TOTALES Y SEGURIDAD -->
            <div class="a4-totals-section">
                <!-- Caja de Clave de Seguridad -->
                @if (!string.IsNullOrWhiteSpace(Model.ClaveEnvio))
                {
                    <div class="a4-security-box">
                        <div style="font-size: 11px; font-weight: 800; color: #b45309; text-transform: uppercase; margin-bottom: 2px;">
                            <i class="fa-solid fa-key me-1"></i> CLAVE SECRETA PARA EL RECOJO
                        </div>
                        <div style="font-size: 24px; font-weight: 900; letter-spacing: 3px; color: #0f172a;">
                            @Model.ClaveEnvio
                        </div>
                        <small style="font-size: 9.5px; color: #64748b;">El destinatario debe presentar su DNI y esta clave en agencia de destino.</small>
                    </div>
                }
                else
                {
                    <div></div>
                }

                <!-- Tabla de Totales -->
                <table class="a4-totals-table">
                    @if (esFactura)
                    {
                        <tr>
                            <td>Op. Gravada:</td>
                            <td>S/ @Model.Subtotal.ToString("N2")</td>
                        </tr>
                        <tr>
                            <td>I.G.V. (18%):</td>
                            <td>S/ @Model.Igv.ToString("N2")</td>
                        </tr>
                    }
                    <tr class="a4-total-row">
                        <td style="padding-top: 4px;">TOTAL PAGADO:</td>
                        <td style="padding-top: 4px; color: #f37021;">S/ @Model.PrecioEnvio.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td style="font-size: 11px; color: #64748b;">Método de Pago:</td>
                        <td style="font-size: 11px; color: #0f172a; text-transform: uppercase;">@Model.MetodoPago</td>
                    </tr>
                </table>
            </div>

            <!-- CÓDIGO DE BARRAS & QR A4 -->
            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 10px;">
                <div style="text-align: left;">
                    <svg id="barcodeA4"></svg>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div id="qrcodeA4"></div>
                    <div style="font-size: 10px; color: #64748b; line-height: 1.3;">
                        <strong>Tours Chota Express</strong><br />
                        Comprobante Electrónico Autorizado.<br />
                        Consulte en www.chotaexpress.com
                    </div>
                </div>
            </div>

            <!-- AGENCIA DIRECTORY -->
            <div style="margin-top: 15px; padding-top: 10px; border-top: 1px dashed #cbd5e1; font-size: 9.5px; color: #64748b;">
                <strong>Nuestras Agencias:</strong>
                Chota (Jr. José Arana 290 - 948 211 532) | Chiclayo (Calle Agricultura 210 - 941 931 014) |
                Cutervo (Jr. 22 de Octubre 1713 - 954 956 993) | Cajamarca (Jr. Angamos 970 - 951 314 266)
            </div>
        </div>

    </div>

    <script>
        // Inicializar códigos de barra
        window.addEventListener('DOMContentLoaded', () => {
            const codigo = "@Model.CodigoSeguimiento";
            
            // Barcode Ticket Térmico
            try {
                JsBarcode("#barcodeThermal", codigo, {
                    format: "CODE128",
                    lineColor: "#000",
                    width: 1.4,
                    height: 34,
                    displayValue: true,
                    fontSize: 10,
                    margin: 0
                });
            } catch (e) { console.error(e); }

            // Barcode A4
            try {
                JsBarcode("#barcodeA4", codigo, {
                    format: "CODE128",
                    lineColor: "#000",
                    width: 1.6,
                    height: 40,
                    displayValue: true,
                    fontSize: 11,
                    margin: 0
                });
            } catch (e) { console.error(e); }

            // Generar QR para rastreo
            const urlRastreo = window.location.origin + "/Encomienda/Rastrear?codigo=" + encodeURIComponent(codigo);
            try {
                new QRCode(document.getElementById("qrcodeThermal"), {
                    text: urlRastreo,
                    width: 72,
                    height: 72,
                    colorDark : "#000000",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.M
                });
            } catch(e) { }

            try {
                new QRCode(document.getElementById("qrcodeA4"), {
                    text: urlRastreo,
                    width: 68,
                    height: 68,
                    colorDark : "#000000",
                    colorLight : "#ffffff",
                    correctLevel : QRCode.CorrectLevel.M
                });
            } catch(e) { }
        });

        function autoImprimir() {
            setTimeout(() => {
                window.print();
            }, 600);
        }

        function cambiarVista(formato) {
            const thermal = document.getElementById("thermalTicketArea");
            const a4 = document.getElementById("a4VoucherArea");
            const pageStyle = document.getElementById("dynamicPageStyle");
            const tabs = document.querySelectorAll(".btn-tab");

            tabs.forEach(t => t.classList.remove("active"));

            if (formato === "a4") {
                thermal.style.display = "none";
                a4.style.display = "block";
                pageStyle.innerHTML = "@@page { size: A4 portrait; margin: 10mm; }";
                tabs[1].classList.add("active");
            } else {
                thermal.style.display = "block";
                a4.style.display = "none";
                pageStyle.innerHTML = "@@page { size: 80mm auto; margin: 0; }";
                tabs[0].classList.add("active");
            }
        }

        function enviarWhatsApp() {
            const telefono = "@(Model.TelefonoRemitente ?? Model.TelefonoDestinatario ?? "")".replace(/\D/g, '');
            const texto = `📦 *TOURS CHOTA EXPRESS* - COMPROBANTE DE ENCOMIENDA\n` +
                          `📄 *Comprobante:* @tituloDoc @numeroDoc\n` +
                          `🔢 *Código de Envío:* @Model.CodigoSeguimiento\n` +
                          `📍 *Ruta:* @(Model.ObjetoRuta?.Origen ?? "Chota") ➔ @(Model.ObjetoRuta?.Destino ?? "Destino")\n` +
                          `👤 *Remitente:* @Model.NombreRemitente\n` +
                          `🎯 *Destinatario:* @Model.NombreDestinatario\n` +
                          `📦 *Paquete:* @Model.Descripcion\n` +
                          `💰 *Total Pagado:* S/ @Model.PrecioEnvio.ToString("N2") (@Model.MetodoPago)\n` +
                          `🔒 *CLAVE DE RECOJO:* @Model.ClaveEnvio\n\n` +
                          `🌐 *Rastree su envío en línea:* ${window.location.origin}/Encomienda/Rastrear?codigo=@Model.CodigoSeguimiento`;

            const url = telefono.length >= 9 
                ? `https://api.whatsapp.com/send?phone=51${telefono}&text=${encodeURIComponent(texto)}`
                : `https://api.whatsapp.com/send?text=${encodeURIComponent(texto)}`;
            window.open(url, '_blank');
        }

        function descargarPDF() {
            const esA4 = document.getElementById("a4VoucherArea").style.display !== "none";
            const elemento = esA4 ? document.getElementById("a4VoucherArea") : document.getElementById("thermalTicketArea");
            const opt = {
                margin:       esA4 ? 5 : 2,
                filename:     `Comprobante_Encomienda_@(numeroDoc).pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'mm', format: esA4 ? 'a4' : [80, 220], orientation: 'portrait' }
            };
            html2pdf().set(opt).from(elemento).save();
        }
    </script>
</body>
</html>
